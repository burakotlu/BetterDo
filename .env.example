# Server only. Never put these values in Gradle, the APK, or source control.
AI_VIDEO_PROVIDER=mock
# Required only for heygen; choose one avatar look and a multilingual voice.
AI_VIDEO_API_KEY=
AI_TEACHER_AVATAR_ID=
AI_TEACHER_VOICE_ID=
# Generate a random token: py -3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This grants access to your personal video service, NOT to the AI provider.
VIDEO_API_TOKEN=
# Publish completed lesson videos for token-free playback. Generation remains private.
PUBLIC_VIDEO_PLAYBACK=true
# Maximum new video submissions across all clients in a rolling 24 hours.
VIDEO_DAILY_LIMIT=10
VIDEO_DATA_DIR=server-data
VIDEO_CATALOG_PATH=content/lessons.json
# On-demand lessons: use a model already installed on your Ollama server.
AI_LESSON_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LESSON_DAILY_LIMIT=30
# Own email delivery for account confirmation. Use your own SMTP host.
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_EMAIL_FROM=
